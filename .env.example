# ==========================================================================
#  다듬 스튜디오 환경변수 예시 파일
#  이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 실제 값을 채우세요.
#  .env 는 .gitignore 에 등록되어 있어 깃에 올라가지 않습니다.
# ==========================================================================

# [필수] 국립국어원 표준국어대사전 오픈 API 인증키
#   발급: https://stdict.korean.go.kr/openapi/openApiInfo.do
#   회원가입 → "오픈 API 신청" → 무료·즉시 발급
#   이 키가 없으면 국어사전 기능은 비활성 상태로 동작합니다.
STDICT_KEY=

# [선택] 국립국어원 우리말샘 오픈 API 인증키
#   발급: https://opendict.korean.go.kr/service/openApiInfo
#   표준국어대사전에서 못 찾았을 때 보조로 찾습니다. 표제어가 훨씬 많아
#   복합명사·신조어·전문용어까지 나옵니다.
#   비워 두면 표준국어대사전만 사용합니다. (기능은 그대로 동작합니다)
OPENDICT_KEY=

# [선택] 서버 포트 (기본값 3787)
PORT=3787

# [선택] 배포 도메인. 설정하면 그 도메인에서 온 요청만 API를 사용할 수 있습니다.
#   (남이 내 서버를 무료 API 서버로 쓰는 것을 막습니다)
#   예: https://your-domain.com
#   비워두면 모든 출처를 허용합니다(로컬 개발용).
ALLOWED_ORIGIN=
